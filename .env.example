# Firebase web config of the corpus project (Firebase console > Project settings > Your apps > Web).
# These values identify the project; they are not secrets (access is the security rules' job), but
# keep the real ones in .env.local, which git ignores. docs/SETUP.md
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
